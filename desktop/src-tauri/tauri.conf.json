{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Celia",
  "identifier": "com.orbita.celia",
  "version": "0.1.0",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Celia - Kubernetes Troubleshooting",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:9119 ws://127.0.0.1:9119; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/celia-server"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "section": "devel",
        "priority": "optional"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"],
        "license": "MIT",
        "release": "1"
      }
    },
    "category": "Development",
    "shortDescription": "Kubernetes troubleshooting and operations tool",
    "longDescription": "Celia is a desktop application for Kubernetes troubleshooting and operations, designed for SREs and platform engineers. It automatically detects common cluster problems and provides actionable diagnosis."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
