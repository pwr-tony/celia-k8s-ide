{
  "$schema": "https://schema.tauri.app/capability/2.0.0",
  "identifier": "default",
  "description": "Default capability for Celia",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/celia-server",
          "sidecar": true
        }
      ]
    }
  ]
}
